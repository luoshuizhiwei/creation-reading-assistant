{
  "name": "creation-reading-assistant",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "author": "Creation Reading Assistant Contributors",
  "description": "Local-first desktop assistant for inspiration capture, AI polishing, local novel reading, and reading-time tracking.",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.node.json && electron-vite build",
    "verify:data-integrity": "node scripts/verify-data-integrity.mjs",
    "verify:hardening": "node scripts/verify-hardening.mjs",
    "verify:inspiration": "node scripts/verify-inspiration.mjs",
    "verify:ai-settings": "node scripts/verify-ai-settings.mjs",
    "verify:search-overlay": "node scripts/verify-search-overlay.mjs",
    "verify:epub-restore": "node scripts/verify-epub-restore.mjs",
    "verify:reader-settings": "node scripts/verify-reader-settings.mjs",
    "verify:portable-storage": "node scripts/verify-portable-storage.mjs",
    "verify:reading-inspiration": "node scripts/verify-reading-inspiration.mjs",
    "verify:reader-formats": "node scripts/verify-reader-formats.mjs",
    "verify:creation-workspace": "node scripts/verify-creation-workspace.mjs",
    "verify:creation-project-shell": "node scripts/verify-creation-project-shell.mjs",
    "verify:creation-editor": "node scripts/verify-creation-editor.mjs",
    "verify:creation-migration-audit": "node scripts/verify-creation-migration-audit.mjs",
    "verify:creation-outline": "node scripts/verify-creation-outline.mjs",
    "verify:creation-cards": "node scripts/verify-creation-cards.mjs",
    "verify:creation-history": "node scripts/verify-creation-history.mjs",
    "verify:creation-export": "node scripts/verify-creation-export.mjs",
    "verify:creation-search": "node scripts/verify-creation-search.mjs",
    "verify:creation-replace": "node scripts/verify-creation-replace.mjs",
    "verify:creation-stats": "node scripts/verify-creation-stats.mjs",
    "verify:creation-proof": "node scripts/verify-creation-proof.mjs",
    "verify:creation-migration": "node scripts/verify-creation-migration.mjs",
    "verify:creation-import": "node scripts/verify-creation-import.mjs",
    "verify:creation-bundle": "node scripts/verify-creation-bundle.mjs",
    "verify:creation-bundle-files": "node scripts/verify-creation-bundle-files.mjs",
    "verify:creation-annotation": "node scripts/verify-creation-annotation.mjs",
    "verify:creation-p1-lifecycle": "node scripts/verify-creation-p1-lifecycle.mjs",
    "verify:backup-restore": "node electron/main/backup/run-contract.mjs",
    "verify:auto-backup": "node scripts/verify-auto-backup.mjs",
    "verify:operation": "node scripts/verify-operation.mjs",
    "verify:resource-integrity": "node scripts/verify-resource-integrity.mjs",
    "verify:creation-resource": "node scripts/verify-creation-resource.mjs",
    "verify:creation-asset-protocol": "node scripts/verify-creation-asset-protocol.mjs",
    "verify:creation-preview": "node scripts/verify-creation-preview.mjs",
    "verify:creation-scale": "node scripts/verify-creation-scale.mjs",
    "verify:creation-schema": "node scripts/verify-creation-schema.mjs",
    "verify:global-card-migration": "node scripts/verify-global-card-migration.mjs",
    "verify:global-card-library": "node scripts/verify-global-card-library.mjs",
    "verify:writing-quick-reference": "vitest run src/features/creation/editor/__tests__/writing-quick-reference.test.tsx src/features/creation/ai/__tests__/build-ai-context.test.ts src/features/creation/editor/__tests__/writing-desk-reference.test.tsx --reporter=dot",
    "verify:desktop-stage3": "vitest run src/features/creation/outline/__tests__/OutlinePage.test.tsx src/features/creation/outline/__tests__/CardBoard.test.tsx src/features/creation/editor/__tests__/writing-desk-reference.test.tsx src/features/creation/editor/__tests__/scene-editor-selection.test.tsx src/features/creation/editor/__tests__/ContinuousChapterEditor.test.tsx src/features/creation/editor/__tests__/scene-document-session.test.ts src/components/layout/__tests__/desktop-frame-nav.test.tsx --reporter=dot",
    "verify:creation-journey": "node scripts/verify-creation-journey.mjs",
    "verify:creation-edge": "node scripts/verify-creation-edge.mjs",
    "verify:creation-planning": "node scripts/verify-creation-planning.mjs",
    "verify:creation-inbox-count": "node scripts/verify-creation-inbox-count.mjs",
    "verify:creation-inbox-convert": "node scripts/verify-creation-inbox-convert.mjs",
    "verify:creation-project-home": "node scripts/verify-creation-project-home.mjs",
    "verify:reader-excerpt": "node scripts/verify-reader-excerpt.mjs",
    "make-icon": "node scripts/make-icon.mjs",
    "visual:capture": "node scripts/visual-capture.mjs",
    "visual:capture:r4": "node scripts/round4-capture.mjs",
    "verify:sync-schema": "node scripts/verify-sync-schema.mjs",
    "verify:sync-server": "node scripts/verify-sync-server.mjs",
    "verify:sync-conflicts": "node scripts/verify-sync-conflicts.mjs",
    "verify:release-readiness": "node scripts/verify-release-readiness.mjs",
    "verify:installer-release": "node scripts/verify-installer-release.mjs",
    "verify:packaged-stage1": "node scripts/packaged-electron-acceptance.mjs",
    "verify:packaged-stage2": "node scripts/packaged-writing-quick-reference-acceptance.mjs",
    "verify:packaged-stage3": "node scripts/packaged-stage3-outline-focus-acceptance.mjs",
    "verify:stage4-preview-print": "node scripts/preview-print-acceptance.mjs",
    "verify:stage4-proof-ignore": "node scripts/proof-ignore-acceptance.mjs",
    "verify:stage4-scene-ai": "node scripts/verify-creation-scene-ai.mjs",
    "verify:stage4-scene-ai-acceptance": "node scripts/scene-ai-acceptance.mjs",
    "verify:stage4-relation-graph": "node scripts/verify-creation-relation-graph.mjs",
    "verify:stage4-relation-graph-acceptance": "node scripts/relation-graph-acceptance.mjs",
    "verify:packaged-stage4": "node scripts/packaged-stage4-acceptance.mjs",
    "verify:packaged-stage4b-print": "node scripts/packaged-stage4b-print-acceptance.mjs",
    "verify:beta": "node scripts/beta-check.mjs",
    "verify:beta:release": "node scripts/beta-check.mjs --require-artifact",
    "release:clean-local": "node scripts/clean-local-release-artifacts.mjs",
    "dist:beta": "npm run build && electron-builder --dir --config.directories.output=release-beta",
    "dist:beta:offline": "npm run build && node scripts/dist-beta-offline.mjs",
    "dist:beta:installer": "npm run build && node scripts/dist-beta-offline.mjs --installer",
    "dist:beta:stage4": "npm run build && electron-builder --dir --config.directories.output=release-beta-stage4-final --publish never",
    "preview": "electron-vite preview",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test": "vitest run"
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "better-sqlite3": "12.4.1",
    "dompurify": "^3.4.13",
    "epubjs": "^0.3.93",
    "iconv-lite": "^0.7.3",
    "jschardet": "^3.1.4",
    "lucide-react": "^0.468.0",
    "mammoth": "1.12.1",
    "markdown-it": "^14.2.0",
    "opencc-js": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "^0.9.12"
    },
    "mammoth": {
      "@xmldom/xmldom": "^0.8.15"
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "33.4.11",
    "electron-builder": "^26.15.2",
    "electron-vite": "^2.3.0",
    "esbuild": "0.21.5",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "local.creationReadingAssistant.app",
    "productName": "创作阅读助手",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
