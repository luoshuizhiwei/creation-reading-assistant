<?xml version="1.0" encoding="utf-8"?>
<!--
  备份/迁移排除规则（Android 12+，配合 android:dataExtractionRules）。
  与 backup_rules.xml 保持一致：书库与创作数据可备份，凭据存储一律排除。
  cloud-backup 覆盖云备份，device-transfer 覆盖换机直传，两者都必须显式声明。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sync_config.xml" />
        <exclude domain="sharedpref" path="webdav_config.xml" />
        <exclude domain="sharedpref" path="ai_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sync_config.xml" />
        <exclude domain="sharedpref" path="webdav_config.xml" />
        <exclude domain="sharedpref" path="ai_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
